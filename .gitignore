# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Extraction-spike sample photos — pixels out, text in.
# Real gate photos are a real shop's supplier prices (and often a phone number
# on the receipt header); the synthetic set is 12MB of generated images. Neither
# belongs in git. The READMEs and their ground-truth tables DO stay tracked.
tool/spike_samples/**/*.jpg
tool/spike_samples/**/*.jpeg
tool/spike_samples/**/*.png
tool/spike_samples/**/*.webp
tool/spike_samples/**/*.heic

# Rendered deck/promo artifacts — source is tracked, output is not.
# presentation/out/ alone is 6.2MB of mp4+pptx that re-renders from src in
# one command. The published promo in docs/ IS tracked, deliberately.
presentation/out/
remotion/out/

# Local secrets for --dart-define-from-file (never commit a key)
.env
